							}

						</tbody>


					</table>
				}

			</div>
		</div>

	</div>
	<div class="col-md-4">
		<div class="card">

			<div class="card-header bg-warning text-black- light"> <strong>Modo Eficiente </strong></div>

			<div class="card-body">
