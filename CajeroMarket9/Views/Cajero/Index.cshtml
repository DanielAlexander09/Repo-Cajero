@model Application.ViewsModels.CreateCajeroViewModels

<div class="container mt-5">
    <h1 class="text-center">Market Cajero</h1>

    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow p-4">
                <form asp-controller="Cajero" asp-action="Index" method="post">
                    <div class="mb-3">
                        <label for="monto" class="form-label">Monto:</label>
                        <input type="text" id="monto" name="monto" class="form-control" asp-for="monto" placeholder="Ingrese Monto" required autocomplete="off"
                         onkeypress="return (event.charCode >=48 && event.charCode <=57)" />
                    </div>

                    <div class="mb-3">
                        <label for="Modo_Dispensador" class="form-label">Modo de Dispensador:</label>
                        <select name="Modo_Dispensador" class="form-select">
                            <option value="1">1</option>
                            <option value="2">2</option>
                            <option value="3">Modo Eficiente</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <button type="submit" class="btn btn-primary">Save</button>
                        <a asp-controller="Market" asp-action="Cajero" class="btn btn-outline-warning float-end me-2"> Back to home</a>
                    </div>
                </form>
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger mt-3">
                        @ViewBag.Error
                    </div>
                }

                @if (ViewBag.Resultado != null)
                {
                    <div class="alert alert-success mt-3">
                        @ViewBag.Resultado
                    </div>
                }
            </div>
        </div>
    </div>
</div>


